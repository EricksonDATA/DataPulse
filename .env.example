# DataPulse Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials.

# Database connection string
# SQLite (local dev without Docker):
#   DATAPULSE_DATABASE_URL=sqlite:///datapulse.db
# PostgreSQL (Docker Compose):
DATAPULSE_DATABASE_URL=postgresql+psycopg://datapulse:change-me@localhost:5432/datapulse

# Logging
DATAPULSE_LOG_LEVEL=INFO

# Environment name (development, staging, production)
DATAPULSE_ENVIRONMENT=development

# API server
DATAPULSE_API_HOST=0.0.0.0
DATAPULSE_API_PORT=8000

# .env.production — Production-like environment configuration
#
# Copy this file to .env and fill in your values.
# NEVER commit the filled .env file.

# PostgreSQL
POSTGRES_USER=datapulse
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=datapulse
POSTGRES_PORT=5432

# API
API_PORT=8000
DATAPULSE_API_KEY=CHANGE_ME_API_KEY
DATAPULSE_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
LOG_LEVEL=INFO

# Grafana
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
